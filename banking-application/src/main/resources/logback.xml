<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Timestamp for new log files each startup -->
    <timestamp key="ts" datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <property name="LOG_DIR" value="logs"/>

    <!-- Clean log pattern -->
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger - %msg%n"/>

    <!-- ========== CONSOLE ========== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ========== APP FILE (INFO, WARN, DEBUG only) ========== -->
    <appender name="APP_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/app/app_${ts}.log</file>
        <append>false</append>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>

        <!-- FILTER: Exclude ERROR logs from app file -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>ACCEPT</onMismatch>
        </filter>
    </appender>

    <!-- ========== ERROR FILE (ERROR only) ========== -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIR}/error/app_error_${ts}.log</file>
        <append>false</append>
        <encoder>
            <pattern>${PATTERN}</pattern>
        </encoder>

        <!-- FILTER: Only ERROR logs go to this file -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <!-- ========== Hibernate SQL (NO bind params) ========== -->
    <logger name="org.hibernate.SQL" level="INFO"/>

    <!-- ROOT logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>